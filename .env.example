# 复制为 .env 并填写（.env 已被 .gitignore 忽略，永不入库）
# 模板文件本身（.env.example）可以提交，用于告知双方需要哪些变量。

# HuggingFace Token：下载/上传模型与数据集（https://huggingface.co/settings/tokens）
HF_TOKEN=

# W&B 实验追踪（统一项目名，见 docs/实验规范.md）
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=industrial-ft

# 数据根目录（私有数据外部挂载时改这里，默认 ./data）
DATA_ROOT=./data

# 输出根目录（模型输出、日志）
OUTPUT_ROOT=./output
